# Copia este archivo a .env y reemplaza los valores. Nunca subas .env al repositorio.

# Base de datos
DB_NAME=nalu
DB_USER=nalu
DB_PASSWORD=cambiar
# Puerto en el host (5433 para no chocar con un PostgreSQL local en 5432)
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/nalu

# Administrador inicial (lo crea DatosSemillaRunner en los perfiles dev y demo)
# NALU_ADMIN_PASSWORD debe tener 12 caracteres o más: si no, el backend no arranca.
# Solo se usa al crear el administrador la primera vez; cambiarla después no cambia su contraseña.
NALU_ADMIN_EMAIL=admin@nalu.local
NALU_ADMIN_PASSWORD=cambiar

# JWT: genera la clave con  openssl rand -base64 32
JWT_SECRET=generar_con_openssl_rand_base64_32
JWT_ISSUER=http://localhost:8080
JWT_ACCESS_TTL=15m
JWT_REFRESH_INACTIVIDAD=30m
JWT_REFRESH_MAXIMO=7d

# Frontend (CORS y verificación de Origin en /auth/refresh)
APP_FRONTEND_URL=http://localhost:4200

# Correo (Mailpit en local)
MAIL_HOST=localhost
MAIL_PORT=1025

# Wompi sandbox (llaves de prueba del panel de Wompi)
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_EVENTS_SECRET=test_events_xxx

# Venta (ADR 003): reserva de inventario en minutos, tarifa plana de envío y envío gratis desde
RESERVA_TTL_MINUTOS=30
NALU_ENVIO_TARIFA=15000
NALU_ENVIO_GRATIS_DESDE=200000

# Opcional: remitente de las notificaciones (por defecto «Nalu <no-responder@nalu.local>»)
# NALU_CORREO_REMITENTE=pedidos@tu-dominio.co

# Carpeta de imágenes subidas (almacenamiento local; el de producción está pendiente)
NALU_ARCHIVOS_DIR=./uploads

# Servidor SSR de Angular: dónde ve la API y cuál es la URL pública de la tienda (sitemap, robots)
NALU_API_URL=http://localhost:8080
NALU_URL_PUBLICA=http://localhost:4200

# IA: Gemini Developer API (Google AI Studio). La llave se crea en https://aistudio.google.com/apikey
# y solo vive en el servidor; nunca se envía al navegador.
# Sin llave (vacía) el asistente de compras se desactiva y el botón «Asesora» no aparece (ADR 005).
GEMINI_API_KEY=cambiar
GEMINI_MODEL=gemini-flash-latest
# Modelos que se prueban, en orden y separados por comas, si el principal está saturado o no existe
GEMINI_MODELOS_RESPALDO=gemini-flash-lite-latest
# Mensajes que una misma persona (cuenta o IP) puede enviar al asistente cada 10 minutos
NALU_ASISTENTE_MENSAJES=20
